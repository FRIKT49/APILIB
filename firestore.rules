rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if the current user has the 'admin' role in their user document
    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // =========================================================================
    // USERS COLLECTION
    // users/{userId}
    // =========================================================================
    match /users/{userId} {
      // Anyone authenticated can read their own profile, admins can read all profiles
      allow read: if isOwner(userId) || isAdmin();

      // Upon registration, any authenticated user can create their own profile document,
      // but role must default to 'user'
      allow create: if isOwner(userId) && 
        (request.resource.data.role == 'user' || isAdmin());

      // Users can update their own profile fields (like displayName), but cannot change 'role'.
      // Only admins can change the 'role' field.
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin();

      // Only admins can delete user records
      allow delete: if isAdmin();

      // -----------------------------------------------------------------------
      // FAVORITES SUBCOLLECTION
      // users/{userId}/favorites/{apiId}
      // -----------------------------------------------------------------------
      match /favorites/{apiId} {
        // Users have full isolated control over their own favorites
        allow read, write, delete: if isOwner(userId);
      }
    }

    // =========================================================================
    // APIS COLLECTION
    // apis/{apiId}
    // =========================================================================
    match /apis/{apiId} {
      // Public catalog: anyone can view APIs
      allow read: if true;

      // Only admins can create new APIs
      allow create: if isAdmin();

      // Updating:
      // 1. Admins have full update rights.
      // 2. Authenticated users can update denormalized rating, ratingCount, updatedAt
      //    or increment popularity when viewing/reviewing.
      allow update: if isAdmin() || (
        isAuthenticated() && 
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['rating', 'ratingCount', 'popularity', 'updatedAt'])
      );

      // Only admins can delete APIs
      allow delete: if isAdmin();
    }

    // =========================================================================
    // REVIEWS COLLECTION
    // reviews/{reviewId}
    // =========================================================================
    match /reviews/{reviewId} {
      // Reviews are publicly readable
      allow read: if true;

      // Authenticated users can create reviews where userId matches their auth UID,
      // with rating between 1 and 5
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5;

      // Users can only edit their own reviews
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5;

      // Review author can delete their review, and admins can moderate (delete) any review
      allow delete: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    // =========================================================================
    // CATEGORIES COLLECTION (Optional lookup)
    // =========================================================================
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
